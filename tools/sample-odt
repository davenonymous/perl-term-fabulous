# it under the same terms as Perl itself.

use v5.32;
use warnings;
use utf8;
use feature 'signatures';
no warnings 'experimental::signatures';

use Encode qw(encode);
use FindBin;
use Getopt::Long qw(GetOptions);
use IO::Compress::Zip qw(:constants $ZipError);
use POSIX qw(tzset);

use constant NAMESPACES => join ' ', map { qq{xmlns:$_->[0]="$_->[1]"} } (
	[ office => 'urn:oasis:names:tc:opendocument:xmlns:office:1.0' ],
	[ style  => 'urn:oasis:names:tc:opendocument:xmlns:style:1.0' ],
	[ text   => 'urn:oasis:names:tc:opendocument:xmlns:text:1.0' ],
	[ fo     => 'urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0' ],
	[ xlink  => 'http://www.w3.org/1999/xlink' ],
);

my $MIMETYPE = 'application/vnd.oasis.opendocument.text';

# Every file of the archive has the same time, the start of the virtual
# clock of the screenshots (2026-06-01 09:41 UTC), so that the archive
# is the same on every run. ZIP archives store local time, so the tool
# writes them in UTC.
use constant FILE_TIME => 1780306860;

my $MANIFEST = <<'XML';
<?xml version="1.0" encoding="UTF-8"?>
<manifest:manifest xmlns:manifest="urn:oasis:names:tc:opendocument:xmlns:manifest:1.0" manifest:version="1.3">
 <manifest:file-entry manifest:full-path="/" manifest:version="1.3" manifest:media-type="application/vnd.oasis.opendocument.text"/>
 <manifest:file-entry manifest:full-path="content.xml" manifest:media-type="text/xml"/>
 <manifest:file-entry manifest:full-path="styles.xml" manifest:media-type="text/xml"/>
</manifest:manifest>
XML

# The named styles, which the user picks by name in a word processor.
my $STYLES = <<"XML";
