#!/usr/bin/env perl

# Writes the example document examples/cookbook/documents/pancakes.odt,
# which the OpenDocument reader of Term::Fabulous::Cookbook::Documents
# shows: a recipe with a title, headings, a bulleted and a numbered list
# with a nested list, bold, italic, underlined and struck text, a
# character style of styles.xml, and links to a web page and to a
# heading. Its files are laid out as LibreOffice writes them, without
# what the reader does not look at (fonts, page layout, settings). Needs
# only core modules.
#
#     perl tools/sample-odt                    # writes examples/cookbook/documents/pancakes.odt
#     perl tools/sample-odt --output FILE.odt
#
# See tools/README.md.
#
