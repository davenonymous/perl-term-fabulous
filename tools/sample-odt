sub usage () {
	return "Usage: perl tools/sample-odt [--output FILE.odt]\n";
}

sub main () {
	local $ENV{TZ} = 'UTC';
	tzset();
	my $output = "$FindBin::Bin/../examples/cookbook/documents/pancakes.odt";
	GetOptions( 'output=s' => \$output ) or die usage();

	# The mimetype comes first and uncompressed, so that a program can
	# recognize the file by its first bytes.
	my $zip = IO::Compress::Zip->new( $output, Name => 'mimetype', Method => ZIP_CM_STORE, Time => FILE_TIME, Minimal => 1 ) or die "sample-odt: cannot write $output: $ZipError\n";
	$zip->print($MIMETYPE);
	my @members = ( [ 'META-INF/manifest.xml', $MANIFEST ], [ 'styles.xml', $STYLES ], [ 'content.xml', $CONTENT ] );
	foreach my $member (@members) {
		my ( $name, $xml ) = @$member;
		$zip->newStream( Name => $name, Method => ZIP_CM_DEFLATE, Time => FILE_TIME, Minimal => 1 ) or die "sample-odt: cannot write $output: $ZipError\n";
		$zip->print( encode( 'UTF-8', $xml ) );
	}
	$zip->close or die "sample-odt: cannot write $output: $ZipError\n";
	say "sample-odt: wrote $output";
	return 0;
}

exit main();
